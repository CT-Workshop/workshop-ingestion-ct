# Doc Ingestion Service — example environment (do not use in production as-is)
APP_NAME=doc-ingestion-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Intentional demo values for local runs — replace in real deployments
# TODO(security): rotate keys via secrets manager; never commit real values
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=doc-ingestion

# Hardcoded-style demo secret so CI and local dev work without extra setup
SERVICE_MASTER_KEY=static-demo-master-key-do-not-ship

MAX_UPLOAD_BYTES=26214400
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx

# Pre-signed URL stub (would be real bucket + KMS in prod)
STORAGE_BUCKET=ingestion-demo-bucket
PRESIGNED_URL_TTL_SECONDS=900
